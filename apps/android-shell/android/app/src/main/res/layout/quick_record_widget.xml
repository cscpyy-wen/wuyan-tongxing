<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_record_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/quick_record_widget_background"
    android:clickable="true"
    android:contentDescription="@string/quick_record_widget_description"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingTop="14dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/quick_record_widget_count"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:autoSizeMaxTextSize="60sp"
        android:autoSizeMinTextSize="24sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="sans-serif-light"
        android:fontFeatureSettings="tnum"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="0"
        android:textColor="@color/quick_record_widget_number"
        android:textSize="54sp" />

    <Chronometer
        android:id="@+id/quick_record_widget_timer"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="6dp"
        android:autoSizeMaxTextSize="19sp"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="sans-serif-medium"
        android:fontFeatureSettings="tnum"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/quick_record_widget_timer"
        android:textSize="19sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/quick_record_widget_empty_timer"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="—:—"
        android:textColor="@color/quick_record_widget_timer"
        android:textSize="19sp" />
</LinearLayout>
