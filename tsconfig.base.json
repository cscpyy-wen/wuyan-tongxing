{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@wuyan/contracts": ["./packages/contracts/src/index.ts"],
      "@wuyan/domain": ["./packages/domain/src/index.ts"],
      "@wuyan/rules": ["./packages/rules/src/index.ts"],
      "@wuyan/content": ["./packages/content/src/index.ts"],
      "@wuyan/content/today": ["./packages/content/src/today.ts"],
      "@wuyan/platform": ["./packages/platform/src/index.ts"]
    }
  }
}
